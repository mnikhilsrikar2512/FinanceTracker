DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=finance_db
DB_USER=sa
DB_PASSWORD=your_password_here

APP_ENV=development
JWT_SECRET=your-secret-key-here
JWT_TENANT_ID=tnt_demo
RATE_LIMIT_STORE_PATH=/tmp/finly_rate_limits.sqlite3
PASSWORD_RESET_STORE_PATH=/tmp/finly_password_resets.sqlite3
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=your_email@gmail.com

ASSISTANT_API_BASE_URL=
ASSISTANT_API_TOKEN=
ASSISTANT_API_AUTH_MODE=auto
ASSISTANT_API_TENANT_ID=tnt_demo
ASSISTANT_API_LOGIN_TENANT_ID=
ASSISTANT_API_LOGIN_EMAIL=
ASSISTANT_API_LOGIN_PASSWORD=
ASSISTANT_API_TIMEOUT_SECONDS=15
ASSISTANT_API_VERIFY_TLS=true
